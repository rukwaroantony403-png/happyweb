# Public website canonical origin, used for sitemap and robots metadata.
HOTEL_SITE_URL=https://happylandhoteldiani.co.ke

# Server-side URL of the authoritative staff booking system. Do not expose this as NEXT_PUBLIC_*.
# Local preview: point this to the local staff app. Production: https://portal.happylandhoteldiani.co.ke
BOOKING_SYSTEM_URL=https://portal.happylandhoteldiani.co.ke

# Optional comma-separated HTTPS hostnames for room photos hosted outside the staff system.
HOTEL_IMAGE_HOSTS=
